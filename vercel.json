{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "excludeFiles": "{tests/**,scripts/**,out/**,.venv/**,.claude/**,roster-chorale.md,README.md,docs/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/carols", "destination": "/carols/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/carols/:path*", "destination": "https://roster-carols.vercel.app/:path*" }
  ]
}
